{
  "name": "dsh-notion-mcp",
  "version": "0.1.3",
  "description": "Connect DeepSeek Harness (dsh) to Notion via the official Notion MCP (OAuth + PKCE)",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "stack:up": "node scripts/test-stack.mjs up",
    "stack:down": "node scripts/test-stack.mjs down",
    "stack:status": "node scripts/test-stack.mjs status"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-cmdline": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-mcp-client": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/cosmokit": "1.8.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.1",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.1",
    "@deepseek-ai/dsh-cmdline": "0.2.1-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.1",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.1",
    "@deepseek-ai/dsh-http-proxy": "0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.1",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.1",
    "@deepseek-ai/dsh-mcp-resources": "0.2.1-rc.1",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.1",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.1",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.1",
    "@deepseek-ai/dsh-util-crypto": "0.2.1-rc.1",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.1",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.1",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.0.0",
    "tsdown": "^0.13.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "notion",
    "mcp",
    "deepseek-harness"
  ],
  "dependencies": {
    "commander": "^15.0.0"
  }
}
